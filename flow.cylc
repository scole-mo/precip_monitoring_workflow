#!jinja2
{% set period_schedules = {6: "PT6H", 24: "T00,T12"} %}

[scheduler]
    UTC mode = True
    allow implicit tasks = True
    [[events]]
        stall timeout = PT3H
        abort on stall timeout = True
        mail events = inactivity timeout, stall
        workflow timeout = P7D
        


[task parameters]
    periods = 6, 24
    # "mvm" = model-vs-model: compares a psuite's own forecast against the opfc
    truths = gpm, analysis, mvm
    days_of_agg = 7, 30
    # psuite47 can be added below (e.g. "opfc, psuite47")
    source = opfc, psuite48
    

[scheduling]
    initial cycle point = {{START_CYCLE_POINT}}
    {% if FINAL_CYCLE_POINT | default(False) %}
    final cycle point = {{FINAL_CYCLE_POINT}}
    {% endif %}
    runahead limit = P0
    [[queues]]
        [[[verpy_plotting_queue]]]
            limit = 10
            members = run_verpy_plotting<periods><truths><source>
        [[[verpy_plotting_ukv_queue]]]
            limit = 10
            members = run_verpy_plotting_ukv<periods><truths>
    [[graph]]
        # Initial prep tasks (first 00Z and 12Z only)
        R1/T00 = """
            prep_prev_fcsts<periods=6><source> =>prep_prev_fcsts<periods=24><source> => get_data<periods><source> & get_gpm<periods> => process_periods_with_prep<periods><source> => process_analysis_with_prep<periods><source>
            get_gpm<periods>
            ##@wall_clock => get_ukv_data<periods> => process_ukv_periods<periods>
        """
        R1/T12 = """
            prep_prev_fcsts<periods><source> => get_data<periods><source> & get_gpm<periods> => process_periods_with_prep<periods><source> => process_analysis_with_prep<periods=6><source>
            get_gpm<periods>
            ##@wall_clock => get_ukv_data<periods> => process_ukv_periods<periods>
        """

        # 6hr period: runs every 6 hours, both truths
        PT6H!{{START_CYCLE_POINT}} = """
            get_data<periods=6><source> => process_analysis<periods=6><source> => run_series_analysis<periods=6, truths=analysis><source>
            get_data<periods=6><source> & get_gpm<periods=6> => process_periods<periods=6><source> => run_series_analysis<periods=6, truths><source>
            #process_periods<periods=6, source=opfc> => run_series_analysis<periods=6, truths=mvm><source>
            #get_ukv_data<periods=6> => process_ukv_periods<periods=6>
            run_series_analysis<periods=6, truths><source>:finish => run_verpy_plotting<periods=6, truths><source>
            run_verpy_plotting<periods=6, truths><source>:finish => update_imt_viewer
        """

        # 24hr period at 00Z: both analysis and GPM, plus aggregated analysis
        T00!{{START_CYCLE_POINT}} = """
            get_data<periods=24><source> => process_analysis<periods=24><source> => run_series_analysis<periods=24, truths=analysis><source>
            ##get_ukv_data<periods=24> => process_ukv_periods<periods=24>
            get_data<periods=24><source> & get_gpm<periods=24> => process_periods<periods=24><source> => run_series_analysis<periods=24, truths=gpm><source>
            #process_periods<periods=24><source> => run_series_analysis<periods=24, truths=mvm><source>
            #process_periods<periods=24, source=opfc> => run_series_analysis<periods=24, truths=mvm><source>
            run_series_analysis<periods=24, truths><source>:finish => run_verpy_plotting<periods=24, truths><source>
            run_series_analysis<periods=24, truths><source>:finish => run_series_analysis_agg<periods=24, truths, days_of_agg><source>
            run_series_analysis_agg<periods=24, truths, days_of_agg=7><source>:finish => run_verpy_plotting_agg<periods=24, truths><source>
            run_series_analysis_agg<periods=24, truths, days_of_agg><source>:finish => housekeep
            run_verpy_plotting<periods=24, truths><source>:finish => update_imt_viewer
            run_verpy_plotting_agg<periods=24, truths><source>:finish => update_imt_viewer
        """

        # 24hr period at 12Z: Gets 12Z forecasts 
        T12!{{START_CYCLE_POINT}} = """
            get_data<periods=24><source> & get_gpm<periods=24> => process_periods<periods=24><source>
            ##get_ukv_data<periods=24> => process_ukv_periods<periods=24>
        """

        # UKV prep - runs once at workflow start to backfill previous forecasts
        R1 = """
            prep_prev_ukv<periods=6>
            get_ukv_data<periods=6>
            prep_prev_ukv<periods=6> & get_ukv_data<periods=6> => process_ukv_analysis_with_prep<periods=6> & process_ukv_periods_with_prep<periods=6>
        """

        # UKV retrieval and plotting chain every 3 hours
        PT3H!{{START_CYCLE_POINT}} = """
            get_ukv_data<periods=6> => process_ukv_analysis<periods=6> & process_ukv_periods<periods=6> => run_series_analysis_ukv<periods=6, truths=analysis> 
            #=> run_verpy_plotting_ukv<periods=6, truths=analysis>
            #get_ukv_data<periods=24> => process_ukv_analysis<periods=24> => run_series_analysis_ukv<periods=24, truths=analysis>
            run_series_analysis_ukv<periods=6, truths=analysis>:finish => run_verpy_plotting_ukv<periods=6, truths=analysis>
            #run_series_analysis_ukv<periods=24, truths=analysis>:finish => run_verpy_plotting_ukv<periods=24, truths=analysis>
            run_verpy_plotting_ukv<periods=6, truths=analysis>:finish => update_imt_viewer
            #run_verpy_plotting_ukv<periods=24, truths=analysis>:finish => update_imt_viewer
        """


[runtime]
    [[root]]
        script = rose task-run
        [[[environment]]]
            SCITOOLS = {{SCITOOLS}}
            OEMPLOT_CONDA_ENV = {{OEMPLOT_CONDA_ENV}}

    [[SET_MAX_LEAD]]
        pre-script = """
        CYCLE_HOUR=${CYLC_TASK_CYCLE_POINT:9:2}
        if [[ "$ACCUM_PERIOD" == "6" ]]; then
            export MAX_LEAD=60
        elif [[ "$ACCUM_PERIOD" == "24" ]]; then
            export MAX_LEAD=144
        fi
        echo "Setting MAX_LEAD=$MAX_LEAD for period=$ACCUM_PERIOD at ${CYCLE_HOUR}Z"
        """

    [[SET_MAX_LEAD_UKV]]
        pre-script = """
        CYCLE_HOUR=${CYLC_TASK_CYCLE_POINT:9:2}
        if [[ "$ACCUM_PERIOD" == "6" ]]; then
            export MAX_LEAD=52
        elif [[ "$ACCUM_PERIOD" == "24" ]]; then
            export MAX_LEAD=48
        fi
        echo "Setting UKV MAX_LEAD=$MAX_LEAD for period=$ACCUM_PERIOD at ${CYCLE_HOUR}Z"
        """

    [[prep_prev_fcsts<periods><source>]]
        inherit = SET_MAX_LEAD
        execution time limit = PT6H
        execution retry delays = 12*PT30M
        [[[environment]]]
            ROSE_TASK_APP = prep_prev_fcsts
            START_CYCLE_POINT = {{START_CYCLE_POINT}}
            DATADIR = {{DATA_DIR}}
            ACCUM_PERIOD = %(periods)s
            PSUITE_ID = %(source)s
        [[[directives]]]
            -l mem = 2gb
            -q = shared
            -l ncpus = 10

    [[prep_prev_gpm<periods>]]
        platform = spice
        env-script = "eval $(rose task-env)"
        pre-script = """
        # Set MAX_LEAD based on accumulation period
        if [[ "$ACCUM_PERIOD" == "6" ]]; then
            export MAX_LEAD=60
        elif [[ "$ACCUM_PERIOD" == "24" ]]; then
            export MAX_LEAD=144
        fi
        
        # Go back 1 time step only (same as accumulation period)
        export PREP_HOURS=${ACCUM_PERIOD}
        echo "Setting PREP_HOURS=$PREP_HOURS and MAX_LEAD=$MAX_LEAD for GPM prep"
        """
        [[[environment]]]
            ROSE_TASK_APP = prep_gpm
            DATADIR = {{DATA_DIR}}
            GPM_DATA_DIR = {{GPM_DATA_DIR}}
            GPM_OBS_TYPE = {{GPM_OBS_TYPE}}
            OUTPUT_DATA = {{PROCESSED_DIR}}
            ACCUM_PERIOD = %(periods)s
            CYCLING_ON = {{PREP}}
        [[[directives]]]
            --mem = 10G
            --time = 10

    [[prep_gpm<periods>]]
        inherit = SET_MAX_LEAD
        platform = spice
        env-script = "eval $(rose task-env)"
        [[[environment]]]
            ROSE_TASK_APP = prep_gpm
            DATADIR = {{DATA_DIR}}
            GPM_DATA_DIR = {{GPM_DATA_DIR}}
            GPM_OBS_TYPE = {{GPM_OBS_TYPE}}
            OUTPUT_DATA = {{PROCESSED_DIR}}
            ACCUM_PERIOD = %(periods)s
            CYCLING_ON = {{CYCLING_ON}}
        [[[directives]]]
            --mem = 10G
            --time = 10

    [[get_data<periods><source>]]
        inherit = SET_MAX_LEAD
        execution time limit = PT4H
        execution retry delays = 12*PT30M
        [[[environment]]]
            ROSE_TASK_APP = get_data
            DATADIR = {{DATA_DIR}}
            ACCUM_PERIOD = %(periods)s
            MODEL = global
            PSUITE_ID = %(source)s
        [[[directives]]]
            --mem = 2G
            

    [[prep_prev_ukv<periods>]]
        inherit = SET_MAX_LEAD_UKV
        execution time limit = PT6H
        execution retry delays = 12*PT30M
        script = """
        # Loop back through previous init times to backfill UKV data
        # UKV runs every 3 hours, so step by 3 (not ACCUM_PERIOD) to cover all inits
        UKV_CYCLE_INTERVAL=3
        for offset in $(seq ${UKV_CYCLE_INTERVAL} ${UKV_CYCLE_INTERVAL} ${MAX_LEAD}); do
            past_date=$(isodatetime -u ${CYLC_TASK_CYCLE_POINT} --offset -PT${offset}H --print-format=%Y%m%dT%H%MZ)
            echo "Fetching UKV data for init time: $past_date"
            bash ${CYLC_WORKFLOW_RUN_DIR}/app/get_data/bin/get_GM_data.sh "$past_date" "$DATADIR" "$MAX_LEAD" "$ACCUM_PERIOD"
        done
        """
        [[[environment]]]
            DATADIR = {{UKV_DATA_DIR}}
            ACCUM_PERIOD = %(periods)s
            MODEL = ukv
        [[[directives]]]
            -l mem = 2gb
            -q = shared
            -l ncpus = 10

    [[get_ukv_data<periods>]]
        inherit = SET_MAX_LEAD_UKV
        execution time limit = PT4H
        execution retry delays = 12*PT30M
        [[[environment]]]
            ROSE_TASK_APP = get_data
            DATADIR = {{UKV_DATA_DIR}}
            ACCUM_PERIOD = %(periods)s
            MODEL = ukv
        [[[directives]]]
            --mem = 2G

    [[get_gpm<periods>]]
        inherit = SET_MAX_LEAD
        platform = spice
        env-script = "eval $(rose task-env)"
        [[[environment]]]
            ROSE_TASK_APP = get_gpm
            DATADIR = {{DATA_DIR}}
            GPM_DATA_DIR = {{GPM_DATA_DIR}}
            GPM_OBS_TYPE = {{GPM_OBS_TYPE}}
            OUTPUT_DATA = {{PROCESSED_DIR}}
            CYCLING_ON = {{CYCLING_ON}}
            ACCUM_PERIOD = %(periods)s
        [[[directives]]]
            --mem = 10G
            --time = 10

    [[PROCESS<periods><source>]]
        platform = spice
        execution retry delays = 6*PT1H
        [[[environment]]]
            OUTPUT_DIR = {{PROCESSED_DIR}}
            DATADIR = {{DATA_DIR}}
            ACCUM_PERIOD = %(periods)s
            MODEL = global
            PSUITE_ID = %(source)s
        [[[directives]]]
            --mem = 20G
            --time = 90

    [[PROCESS_UKV<periods>]]
        platform = spice
        execution retry delays = 6*PT1H
        [[[environment]]]
            OUTPUT_DIR = {{UKV_PROCESSED_DIR}}
            DATADIR = {{UKV_DATA_DIR}}
            ACCUM_PERIOD = %(periods)s
            MODEL = ukv
        [[[directives]]]
            --mem = 20G
            --time = 90

    [[process_analysis<periods><source>]]
        inherit = PROCESS<periods><source>
        [[[environment]]]
            ROSE_TASK_APP = process_analysis

    [[process_analysis_with_prep<periods><source>]]
        inherit = PROCESS<periods><source>, SET_MAX_LEAD
        script = """
        export PREP_HOURS=${MAX_LEAD:-60}
        echo "Setting PREP_HOURS=$PREP_HOURS for analysis backfill"
        rose task-run
        """
        [[[environment]]]
            ROSE_TASK_APP = process_analysis

    [[process_periods<periods><source>]]
        inherit = PROCESS<periods><source>
        [[[environment]]]
            ROSE_TASK_APP = process_periods

    [[process_periods_with_prep<periods><source>]]
        inherit = PROCESS<periods><source>, SET_MAX_LEAD
        script = """
        export PREP_HOURS=${MAX_LEAD:-144}
        echo "Setting PREP_HOURS=$PREP_HOURS from MAX_LEAD"
        rose task-run
        """
        [[[environment]]]
            ROSE_TASK_APP = process_periods

    # UKV processing tasks
    [[process_ukv_analysis<periods>]]
        inherit = PROCESS_UKV<periods>
        [[[environment]]]
            ROSE_TASK_APP = process_analysis

    [[process_ukv_analysis_with_prep<periods>]]
        inherit = PROCESS_UKV<periods>, SET_MAX_LEAD_UKV
        script = """
        export PREP_HOURS=${MAX_LEAD:-48}
        echo "Setting PREP_HOURS=$PREP_HOURS for UKV analysis backfill"
        rose task-run
        """
        [[[environment]]]
            ROSE_TASK_APP = process_analysis

    [[process_ukv_periods<periods>]]
        inherit = PROCESS_UKV<periods>
        [[[environment]]]
            ROSE_TASK_APP = process_periods

    [[process_ukv_periods_with_prep<periods>]]
        inherit = PROCESS_UKV<periods>, SET_MAX_LEAD_UKV
        script = """
        export PREP_HOURS=${MAX_LEAD:-48}
        echo "Setting PREP_HOURS=$PREP_HOURS for UKV periods backfill"
        rose task-run
        """
        [[[environment]]]
            ROSE_TASK_APP = process_periods

    [[run_series_analysis<periods><truths><source>]]
        platform = spice
        env-script = "eval $(rose task-env)"
        pre-script = """
        CYCLE_HOUR=${CYLC_TASK_CYCLE_POINT:9:2}
        # Format accumulation period with leading zero (6 -> 06, 24 -> 24)
        export ACCUM_PERIOD_FMT=$(printf "%02d" ${ACCUM_PERIOD})
        
        if [[ "$ACCUM_PERIOD" == "6" ]]; then
            export LEAD_SEQ=6,60,6
            export MAX_LEAD=60
        elif [[ "$ACCUM_PERIOD" == "24" ]]; then
            if [[ "$CYCLE_HOUR" == "00" ]]; then
                export LEAD_SEQ=36,144,12
            else
                export LEAD_SEQ=36,132,24
            fi
            export MAX_LEAD=144
        fi
        
        # For single cycle analysis, start = end = cycle point
        export VALID_START=${CYLC_TASK_CYCLE_POINT}
        export AGG_LABEL=""
        
        echo "Setting LEAD_SEQ=$LEAD_SEQ and MAX_LEAD=$MAX_LEAD"
        echo "VALID_START=$VALID_START, VALID_END=$CYLC_TASK_CYCLE_POINT"
        """
        [[[environment]]]
            ROSE_TASK_APP = run_series_analysis
            FINAL_CYCLE_POINT = {{FINAL_CYCLE_POINT | default('')}}
            ACCUM_DATA_DIR = {{PROCESSED_DIR}}
            DATADIR = {{DATA_DIR}}
            OUTPUT_BASE = {{OUTPUT_BASE}}
            AREA_MASKS = {{AREA_MASKS}}
            ACCUM_PERIOD = %(periods)s
            TRUTH = %(truths)s
            PSUITE_ID = %(source)s
            MET_OUTPUT_DIR = {{MET_OUTPUT_DIR}}/%(source)s/%(truths)s
        [[[directives]]]
            --mem = 120G
            --time = 30
            --cpus-per-task = 10

{% for period in period_schedules.keys() %}
    [[run_series_analysis<periods={{period}}><truths><source>]]
        execution retry delays = 3*PT30M
        [[[events]]]
            failed handlers = handle_met_failure.sh %(workflow)s %(point)s %(name)s %(submit_num)s
{% endfor %}

    [[run_series_analysis_ukv<periods><truths>]]
        platform = spice
        env-script = "eval $(rose task-env)"
        pre-script = """
        CYCLE_HOUR=${CYLC_TASK_CYCLE_POINT:9:2}
        export ACCUM_PERIOD_FMT=$(printf "%02d" ${ACCUM_PERIOD})
        
        if [[ "$ACCUM_PERIOD" == "6" ]]; then
            export LEAD_SEQ=6,48,6
            export MAX_LEAD=48
        elif [[ "$ACCUM_PERIOD" == "24" ]]; then
            export LEAD_SEQ=24,48,24
            export MAX_LEAD=48
        fi
        
        # Same as global: VALID_START = VALID_END = cycle point
        export VALID_START=${CYLC_TASK_CYCLE_POINT}
        export AGG_LABEL=""
        
        echo "UKV SeriesAnalysis: LEAD_SEQ=$LEAD_SEQ, MAX_LEAD=$MAX_LEAD"
        echo "VALID_START=$VALID_START, VALID_END=$CYLC_TASK_CYCLE_POINT"
        """
        execution retry delays = 3*PT30M
        [[[environment]]]
            ROSE_TASK_APP = run_series_analysis
            FINAL_CYCLE_POINT = {{FINAL_CYCLE_POINT | default('')}}
            ACCUM_DATA_DIR = {{UKV_PROCESSED_DIR}}
            DATADIR = {{UKV_DATA_DIR}}
            OUTPUT_BASE = {{OUTPUT_BASE}}
            AREA_MASKS = {{AREA_MASKS}}
            ACCUM_PERIOD = %(periods)s
            TRUTH = %(truths)s
            MET_OUTPUT_DIR = {{MET_OUTPUT_DIR}}/ukv/%(truths)s
        [[[directives]]]
            --mem = 20G
            --time = 360
            --cpus-per-task = 8
        [[[events]]]
            failed handlers = handle_met_failure.sh %(workflow)s %(point)s %(name)s %(submit_num)s

    [[run_series_analysis_agg<periods><truths><days_of_agg><source>]]
        platform = spice
        env-script = "eval $(rose task-env)"
        pre-script = """
        CYCLE_HOUR=${CYLC_TASK_CYCLE_POINT:9:2}
        export ACCUM_PERIOD_FMT=$(printf "%02d" ${ACCUM_PERIOD})
        
        # Calculate days back from days_of_agg parameter (subtract 1 because we include current day)
        DAYS_BACK=$((DAYS_OF_AGG - 1))
        
        # Check if we have enough data - compare cycle point to start + required days
        CYCLE_DATE=${CYLC_TASK_CYCLE_POINT:0:8}
        START_DATE_RAW={{START_CYCLE_POINT}}
        START_DATE=${START_DATE_RAW:0:8}
        MIN_DATE=$(date -u -d "${START_DATE} +${DAYS_BACK} days" +%Y%m%d)
        
        if [[ "$CYCLE_DATE" < "$MIN_DATE" ]]; then
            echo "Skipping: Not enough data yet. Need ${DAYS_OF_AGG} days, current cycle $CYCLE_DATE < minimum $MIN_DATE"
            exit 0
        fi
        
        if [[ "$ACCUM_PERIOD" == "6" ]]; then
            export LEAD_SEQ=6,60,6
            export MAX_LEAD=60
            CYCLE_TIME=${CYLC_TASK_CYCLE_POINT:9:4}
            START_DATE=$(date -u -d "${CYCLE_DATE} -${DAYS_BACK} days" +%Y%m%d)
            export VALID_START="${START_DATE}T${CYCLE_TIME}Z"
        elif [[ "$ACCUM_PERIOD" == "24" ]]; then
            if [[ "$CYCLE_HOUR" == "00" ]]; then
                export LEAD_SEQ=36,144,12
            else
                export LEAD_SEQ=36,132,24
            fi
            export MAX_LEAD=144
            # For 24hr, force VALID_START to 00Z
            START_DATE=$(date -u -d "${CYCLE_DATE} -${DAYS_BACK} days" +%Y%m%d)
            export VALID_START="${START_DATE}T0000Z"
        fi
        
        export AGG_LABEL="${DAYS_OF_AGG}day"
        
        echo "Setting LEAD_SEQ=$LEAD_SEQ and MAX_LEAD=$MAX_LEAD"
        echo "Running Series Analysis Aggregation period: ${AGG_LABEL} (${DAYS_OF_AGG} days)"
        echo "VALID_START=$VALID_START, VALID_END=$CYLC_TASK_CYCLE_POINT"
        """
        [[[environment]]]
            ROSE_TASK_APP = run_series_analysis_agg
            FINAL_CYCLE_POINT = {{FINAL_CYCLE_POINT | default('')}}
            ACCUM_DATA_DIR = {{PROCESSED_DIR}}
            DATADIR = {{DATA_DIR}}
            OUTPUT_BASE = {{OUTPUT_BASE}}
            AREA_MASKS = {{AREA_MASKS}}
            ACCUM_PERIOD = %(periods)s
            TRUTH = %(truths)s
            DAYS_OF_AGG = %(days_of_agg)s
            PSUITE_ID = %(source)s
            MET_OUTPUT_DIR = {{MET_OUTPUT_DIR}}/%(source)s/%(truths)s
        [[[directives]]]
            --mem = 30G
            --time = 240

    [[run_verpy_plotting<periods><truths><source>]]
        platform = spice
        execution retry delays = 30*PT1H
        env-script = "eval $(rose task-env)"
        pre-script = """
        CYCLE_HOUR=${CYLC_TASK_CYCLE_POINT:9:2}
        if [[ "$ACCUM_PERIOD" == "6" ]]; then
            export LEAD_SEQ=6,60,6
        elif [[ "$ACCUM_PERIOD" == "24" ]]; then
            if [[ "$CYCLE_HOUR" == "00" ]]; then
                export LEAD_SEQ=12,144,12
            else
                export LEAD_SEQ=36,132,24
            fi
        fi
        echo "Setting LEAD_SEQ=$LEAD_SEQ for VerPy plotting, period=$ACCUM_PERIOD at ${CYCLE_HOUR}Z"
        """
        [[[environment]]]
            ROSE_TASK_APP = run_verpy_plotting
            MET_SOURCE = {{MET_OUTPUT_DIR}}/%(source)s/%(truths)s
            OUTDIR = {{OUTPUT_BASE}}/verpy_plots/%(source)s
            ACCUM_PERIOD = %(periods)s
            TRUTH = %(truths)s
            MODEL = global
            PSUITE_ID = %(source)s
        [[[directives]]]
            --mem = 20G
            --time = 220

    [[run_verpy_plotting_agg<periods><truths><source>]]
        platform = spice
        execution retry delays = 3*PT30M
        env-script = "eval $(rose task-env)"
        pre-script = """
        CYCLE_HOUR=${CYLC_TASK_CYCLE_POINT:9:2}

        export AGG_LABEL="7day"
        export AGGREGATED=true

        # This task is only ever triggered for the 7-day aggregation (see the
        # run_series_analysis_agg<days_of_agg=7> trigger in [[graph]]), so
        # DAYS_OF_AGG is fixed here to compute the matching VALID_START used
        # to find the AGGREGATED MET output files written by that task.
        DAYS_OF_AGG=7
        DAYS_BACK=$((DAYS_OF_AGG - 1))
        CYCLE_DATE=${CYLC_TASK_CYCLE_POINT:0:8}

        if [[ "$ACCUM_PERIOD" == "6" ]]; then
            export LEAD_SEQ=6,60,6
            CYCLE_TIME=${CYLC_TASK_CYCLE_POINT:9:4}
            START_DATE=$(date -u -d "${CYCLE_DATE} -${DAYS_BACK} days" +%Y%m%d)
            export VALID_START="${START_DATE}T${CYCLE_TIME}Z"
        elif [[ "$ACCUM_PERIOD" == "24" ]]; then
            if [[ "$CYCLE_HOUR" == "00" ]]; then
                export LEAD_SEQ=36,144,12
            else
                export LEAD_SEQ=36,132,24
            fi
            # For 24hr, force VALID_START to 00Z (matches run_series_analysis_agg)
            START_DATE=$(date -u -d "${CYCLE_DATE} -${DAYS_BACK} days" +%Y%m%d)
            export VALID_START="${START_DATE}T0000Z"
        fi
        echo "Setting LEAD_SEQ=$LEAD_SEQ for VerPy plotting, period=$ACCUM_PERIOD, agg=$AGG_LABEL, VALID_START=$VALID_START"
        """
        [[[environment]]]
            ROSE_TASK_APP = run_verpy_plotting
            MET_SOURCE = {{MET_OUTPUT_DIR}}/%(source)s/%(truths)s
            # Shares the same output tree as run_verpy_plotting - the agg_suffix
            # (e.g. "_agg7d") added to the job folder name by --aggregated
            # already keeps these distinct, so there's no need for a separate
            # verpy_plots_agg tree that downstream tools would have to know to
            # also scan.
            OUTDIR = {{OUTPUT_BASE}}/verpy_plots/%(source)s
            ACCUM_PERIOD = %(periods)s
            TRUTH = %(truths)s
            MODEL = global
            PSUITE_ID = %(source)s
        [[[directives]]]
            --mem = 20G
            --time = 220

    [[run_verpy_plotting_ukv<periods><truths>]]
        platform = spice
        execution retry delays = 30*PT1H
        env-script = "eval $(rose task-env)"
        pre-script = """
        CYCLE_HOUR=${CYLC_TASK_CYCLE_POINT:9:2}
        if [[ "$ACCUM_PERIOD" == "6" ]]; then
            export LEAD_SEQ=6,48,6
        elif [[ "$ACCUM_PERIOD" == "24" ]]; then
            export LEAD_SEQ=24,48,24
        fi
        echo "Setting LEAD_SEQ=$LEAD_SEQ for UKV VerPy plotting, period=$ACCUM_PERIOD at ${CYCLE_HOUR}Z"
        """
        [[[environment]]]
            ROSE_TASK_APP = run_verpy_plotting
            MET_SOURCE = {{MET_OUTPUT_DIR}}/ukv/%(truths)s
            OUTDIR = {{OUTPUT_BASE}}/verpy_plots
            ACCUM_PERIOD = %(periods)s
            TRUTH = %(truths)s
            MODEL = ukv
        [[[directives]]]
            --mem = 20G
            --time = 180
            --cpus-per-task = 10

    [[update_imt_viewer]]
        # Updates the ImageMetaTag webpage after VerPy plotting
        platform = spice
        script = """
            module load scitools
            python $CYLC_WORKFLOW_RUN_DIR/bin/convert_verpy_to_imt.py
            python $CYLC_WORKFLOW_RUN_DIR/bin/create_imt_webpage.py
        """
        execution time limit = PT10M
        [[[directives]]]
            --mem = 20G
            --time = 180
    

    [[housekeep]]
        # rose_prune: removes old logs, raw pp, processed nc, GPM obs nc,
        # and MET output while retaining 31 days of processed/obs data
        # for the aggregation window and all generated plots.
        [[[environment]]]
            ROSE_TASK_APP = housekeep
            DATADIR = {{DATA_DIR}}
            PROCESSED_DIR = {{PROCESSED_DIR}}
            MET_OUTPUT_DIR = {{MET_OUTPUT_DIR}}